            <Property name="lineWrap" type="boolean" value="true"/>
            <Property name="rows" type="int" value="5"/>
            <Property name="text" type="java.lang.String" value="Repeat code with different types of loops.&#xa;&#xa;1. FOR LOOP - Repeat fixed number of times&#xa;&#xa;begin&#xa;    nmbr count = 3&#xa;    &#xa;    for count times&#xa;        disp &quot;Hello!&quot;&#xa;    stop&#xa;close&#xa;&#xa;&#xa;2. WHILE LOOP - Repeat while condition is true&#xa;&#xa;begin&#xa;    nmbr counter = 1&#xa;    &#xa;    while counter &lt;= 5&#xa;        disp &quot;Count: &quot; + counter&#xa;        counter = counter + 1&#xa;    stop&#xa;close&#xa;&#xa;&#xa;3. DO-UNTIL LOOP - Execute at least once&#xa;&#xa;begin&#xa;    nmbr guess = 0&#xa;    &#xa;    do&#xa;        disp &quot;Enter a number:&quot;&#xa;        input guess&#xa;    until guess == 7&#xa;close&#xa;"/>
            <Property name="wrapStyleWord" type="boolean" value="true"/>
          </Properties>
        </Component>
      </SubComponents>
    </Container>
  </SubComponents>
