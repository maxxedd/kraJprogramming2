                  <Font name="Tahoma" size="14" style="0"/>
                </Property>
                <Property name="lineWrap" type="boolean" value="true"/>
                <Property name="rows" type="int" value="5"/>
                <Property name="text" type="java.lang.String" value="KRAJ is a pseudocode interpreter (version 0.1.4) developed in fulfillment of the requirements for ICT 115 - Programming Languages. It is designed to help users understand how algorithms work by simulating the execution of pseudocode.&#xa;&#xa;This interpreter includes a lexical analyzer, which scans the pseudocode source and splits it into tokens&#x2014;the smallest meaningful units such as keywords, identifiers, operators, and literals. By tokenizing the input, KRAJ can analyze, validate, and execute instructions in a structured way, making it easier to visualize program flow and learn algorithmic logic."/>
                <Property name="wrapStyleWord" type="boolean" value="true"/>
                <Property name="border" type="javax.swing.border.Border" editor="org.netbeans.modules.form.editors2.BorderEditor">
                  <Border info="null"/>
                </Property>
                <Property name="cursor" type="java.awt.Cursor" editor="org.netbeans.modules.form.editors2.CursorEditor">
                  <Color id="Text Cursor"/>
                </Property>
              </Properties>
            </Component>
