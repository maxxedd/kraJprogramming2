                <Property name="rows" type="int" value="5"/>
                <Property name="text" type="java.lang.String" value="Operators are symbols that perform operations on variables and values. KRAJ has several types of operators for different purposes.&#xa;&#xa;ARITHMETIC OPERATORS&#xa;&#xa;Used for mathematical calculations.&#xa;&#xa;Operator&#x9;Name&#x9;Example&#x9;Result&#xa;+&#x9;Addition&#x9;5 + 3&#x9;8&#xa;-&#x9;Subtraction&#x9;10 - 4&#x9;6&#xa;*&#x9;Multiplication&#x9;6 * 7&#x9;42&#xa;/&#x9;Division&#x9;15 / 3&#x9;5&#xa;=&#x9;Assignment&#x9;nmbr x = 5&#x9;x becomes 5&#xa;&#xa;&#xa;COMPARISON OPERATORS&#xa;&#xa;Used to compare values in conditions (return TRUE or FALSE).&#xa;&#xa;Operator&#x9;Name&#x9;Example&#x9;Result&#xa;==&#x9;Equal to&#x9;5 == 5&#x9;TRUE&#xa;!=&#x9;Not equal to&#x9;5 != 3&#x9;TRUE&#xa;&lt;&#x9;Less than&#x9;5 &lt; 10&#x9;TRUE&#xa;&gt;&#x9;Greater than&#x9;5 &gt; 3&#x9;TRUE&#xa;&lt;=&#x9;Less than or equal&#x9;5 &lt;= 5&#x9;TRUE&#xa;&gt;=&#x9;Greater than or equal&#x9;5 &gt;= 5&#x9;TRUE&#xa;&#xa;&#xa;"/>
                <Property name="wrapStyleWord" type="boolean" value="true"/>
              </Properties>
            </Component>
          </SubComponents>
