                <Property name="rows" type="int" value="5"/>
                <Property name="text" type="java.lang.String" value="Here&apos;s a complete program using all features:&#xa;&#xa;begin&#xa;    // Use ONLY integers for everything&#xa;    nmbr studentCount = 5&#xa;    nmbr total = 0&#xa;    nmbr grade&#xa;    nmbr i = 1&#xa;    &#xa;    disp &quot;=== Grade Calculator ===&quot;&#xa;    &#xa;    for studentCount times&#xa;        disp &quot;Enter grade for student &quot; + i + &quot;:&quot;&#xa;        input grade&#xa;        &#xa;        // Simple validation - just make sure it&apos;s reasonable&#xa;        if grade &lt; 0&#xa;            grade = 0&#xa;        endif&#xa;        &#xa;        if grade &gt; 100&#xa;            grade = 100&#xa;        endif&#xa;        &#xa;        // Simple grading&#xa;        if grade &gt;= 90&#xa;            disp &quot;Grade: A&quot;&#xa;        elif grade &gt;= 80&#xa;            disp &quot;Grade: B&quot;&#xa;        elif grade &gt;= 70&#xa;            disp &quot;Grade: C&quot;&#xa;        elif grade &gt;= 60&#xa;            disp &quot;Grade: D&quot;&#xa;        else&#xa;            disp &quot;Grade: F&quot;&#xa;        endif&#xa;        &#xa;        total = total + grade&#xa;        i = i + 1&#xa;    stop&#xa;    &#xa;    nmbr average = total / studentCount&#xa;    disp &quot;Average: &quot; + average&#xa;    &#xa;    // Simple final evaluation&#xa;    if average &gt;= 90&#xa;        disp &quot;Excellent class! \ud83c\udf1f&quot;&#xa;    elif average &gt;= 80&#xa;        disp &quot;Good class! \ud83d\udc4d&quot;&#xa;    elif average &gt;= 70&#xa;        disp &quot;Average class. \ud83d\ude42&quot;&#xa;    elif average &gt;= 60&#xa;        disp &quot;Below average. \ud83d\udcdd&quot;&#xa;    else&#xa;        disp &quot;Needs improvement. &#x26a0;&#xfe0f;&quot;&#xa;    endif&#xa;close" containsInvalidXMLChars="true"/>
              </Properties>
            </Component>
